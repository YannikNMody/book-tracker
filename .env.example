# Copy this file to ".env" in the same folder and fill in the value.
# .env is ignored by Git. Never commit it, never paste it into a chat.
#
# Where to get it:
#   Supabase dashboard -> your project -> "Connect" (top of the page)
#   -> "Session pooler" -> copy the URI
#   -> replace [YOUR-PASSWORD] with your database password
#      (forgot it? Project Settings -> Database -> Reset database password.
#       Special characters are fine: the loader encodes them for the URL.)
#
# The copied URI already has your project reference and pooler host filled in;
# the line below shows the shape with placeholders only.
#
# Use the Session pooler, not "Direct connection": the direct one needs IPv6,
# which many home networks and GitHub Actions don't have.

DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@YOUR-POOLER-HOST:5432/postgres
